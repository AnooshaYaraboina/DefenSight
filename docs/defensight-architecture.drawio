  <diagram id="2-·-detection-pipeline" name="2 · Detection Pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="850" background="#08080c" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="REQUEST PIPELINE   —   src/lib/engine/pipeline.ts   ·   one analyze() call, 14 ordered stages" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0b0b12;strokeColor=#22222e;fontColor=#6f6f85;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontStyle=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1620" height="60" as="geometry" /></mxCell>
        <mxCell id="n2" value="1  INGEST request, principal, agent, channel" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#4a4a5e;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="280" height="92" as="geometry" /></mxCell>
        <mxCell id="n3" value="2  INPUT GUARDRAIL screen the user's prompt" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#22d3ee;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="140" width="280" height="92" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n5" value="3  RAG RETRIEVAL documents pulled for context" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#22d3ee;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="140" width="280" height="92" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n7" value="4  DOCUMENT SCAN trust + injection in retrieved text" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#22d3ee;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="140" width="280" height="92" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n9" value="5  THREAT DETECTION all layers, then noisy-OR fusion" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#8b5cf6;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1350" y="140" width="280" height="92" as="geometry" /></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n11" value="6  AGENT BEHAVIOR observed actions vs stated intent" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#22d3ee;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="280" height="92" as="geometry" /></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n13" value="7  RISK SCORING 12 factors → 0-100, explainable" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#8b5cf6;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="290" width="280" height="92" as="geometry" /></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n15" value="8  OUTPUT ANALYSIS moved BEFORE scoring — findings must reach the score" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#fbbf24;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="290" width="280" height="92" as="geometry" /></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n17" value="9  POLICY EVALUATION 18 policies, most-restrictive wins" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#8b5cf6;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="290" width="280" height="92" as="geometry" /></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n19" value="10  TOOL AUTHORIZATION default-closed gateway" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#f43f5e;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1350" y="290" width="280" height="92" as="geometry" /></mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#f43f5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n17" target="n19"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n21" value="11  TOOL EXECUTION only what was granted" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#22d3ee;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="440" width="280" height="92" as="geometry" /></mxCell>
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n23" value="12  OUTPUT GUARDRAIL screen the response" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#22d3ee;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="440" width="280" height="92" as="geometry" /></mxCell>
        <mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n21" target="n23"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n25" value="13  RESPONSE deliver, redacted if required" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#34d399;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="440" width="280" height="92" as="geometry" /></mxCell>
        <mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n27" value="14  ALERTING → INCIDENT critical opens a case with the chain" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#f43f5e;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="440" width="280" height="92" as="geometry" /></mxCell>
        <mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#f43f5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n25" target="n27"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n29" value="Decision ladder   ALLOW → WARN → REDACT → REQUIRE_APPROVAL → BLOCK The most restrictive matched action always wins, so evaluation order can never weaken a verdict." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#fbbf24;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="620" width="700" height="70" as="geometry" /></mxCell>
        <mxCell id="n30" value="Fusion combines across LAYERS, not across detections. Ten pattern hits from one detector are still one opinion; confidence is capped by the number of independent behaviours observed: [0.45, 0.62, 0.86, 0.94, 0.97]" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#8b5cf6;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="620" width="620" height="70" as="geometry" /></mxCell>
        <mxCell id="n31" value="Measured outcome: 0% false positives across 616 benign requests · 92.3% detection across 104 attacks 8/8 simulator scenarios defended · 19/19 test matrix · 83 unit tests" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#34d399;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="720" width="1350" height="56" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
