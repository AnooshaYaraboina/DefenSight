        <mxCell id="n1" value="WAR ROOM   —   src/app/(console)/dashboard/page.tsx   ·   five elements, no scrolling at 1440×900" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0b0b12;strokeColor=#22222e;fontColor=#6f6f85;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontStyle=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1500" height="60" as="geometry" /></mxCell>
