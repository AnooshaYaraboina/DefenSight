        <mxCell id="n4" value="&lt;Wall/&gt;  client shell h-dvh + overflow-hidden makes the no-scroll promise structural" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#8b5cf6;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="350" width="260" height="84" as="geometry" /></mxCell>
        <mxCell id="n5" value="① Status rail live state · org · THREAT LEVEL · clock · burst" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#fbbf24;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="130" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="n6" value="② Posture radial score · verdict · 24h pulse" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#333342;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="220" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="n7" value="③ Estate map   (the centrepiece) ingress → applications → agents → tool surface real edges · live packets · blocked ones detonate" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#8b5cf6;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="310" width="300" height="84" as="geometry" /></mxCell>
        <mxCell id="n8" value="④ Needs you incidents · approvals · quarantined" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#f43f5e;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="420" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="n9" value="⑤ Vitals + wire 4 figures · last interception" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#333342;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="510" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="n10" value="/api/stream  (SSE) replay 20 · heartbeat 20s" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#22d3ee;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="200" width="250" height="64" as="geometry" /></mxCell>
        <mxCell id="n11" value="Packet per live event CSS motion path (offset-path) via custom property — React 19 drops an offsetPath style key" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#22d3ee;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="250" height="96" as="geometry" /></mxCell>
        <mxCell id="n12" value="toolSlugs on the event payload so the tool leg is the real tool, not a guess from the agent's grants" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#34d399;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="420" width="250" height="84" as="geometry" /></mxCell>
        <mxCell id="n13" value="Traffic auto-starts on arrival 4s interval · 12% attack rate" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#fbbf24;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="530" width="250" height="64" as="geometry" /></mxCell>
        <mxCell id="n14" value="REMOVED from this page on purpose — each has its own screen: detection layers · policy hits · guardrail status · data-protection breakdown RAG status · agent and tool tables · recommendations · range switcher" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#4a4a5e;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="200" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="n15" value="Height budget at 900px: rail 48 + watchfloor 632 + vitals 96 + wire 56 + gaps 68  =  900" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#6f6f85;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1060" y="340" width="420" height="74" as="geometry" /></mxCell>
        <mxCell id="n16" value="Theme: obsidian + electric violet. Chart palette re-validated against the new panel #101018. Decision colours moved OFF green — allow-green vs block-red measured ΔE 4.3 under deuteranopia, i.e. indistinguishable." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#f43f5e;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="430" width="420" height="100" as="geometry" /></mxCell>
