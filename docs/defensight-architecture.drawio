      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="SENTRY   —   the assistant that runs workflows   ·   reads freely, every write is gated" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0b0b12;strokeColor=#22222e;fontColor=#6f6f85;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=12;fontStyle=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1500" height="60" as="geometry" /></mxCell>
        <mxCell id="n2" value="User message" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#333342;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="n3" value="planFor(message) DETERMINISTIC routing. The model writes narration; it never chooses what runs." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#fbbf24;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="220" width="200" height="96" as="geometry" /></mxCell>
        <mxCell id="n4" value="No workflow matched → /api/assistant read-only snapshot answer" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#333342;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="350" width="200" height="74" as="geometry" /></mxCell>
        <mxCell id="n5" value="performanceFor(message) dance · spin · look busy · alarm answered locally, no round trip" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#8b5cf6;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="450" width="200" height="74" as="geometry" /></mxCell>
        <mxCell id="n6" value="Step loop  (client-driven) POST /api/assistant/workflow action: step  Stateless server · the approval pause costs nothing" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#8b5cf6;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="200" width="250" height="130" as="geometry" /></mxCell>
        <mxCell id="n7" value="kind: read runs immediately" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#34d399;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="180" width="200" height="56" as="geometry" /></mxCell>
        <mxCell id="n8" value="kind: write STOPS. Waits for a person." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#f43f5e;fontColor=#ededf5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="260" width="200" height="56" as="geometry" /></mxCell>
        <mxCell id="n9" value="Approve / Leave it" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#fbbf24;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="260" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="n10" value="Same endpoints a human uses same permission check same audit entry" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#f43f5e;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="250" width="250" height="74" as="geometry" /></mxCell>
        <mxCell id="n11" value="Workflows  scan — runs the production RAG scanner investigate — chain, correlation, verdict triage — queue vs grants and tier hunt — sweep + control coverage" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#333342;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="380" width="250" height="130" as="geometry" /></mxCell>
        <mxCell id="n12" value="History localStorage, not the database: the things that need recording already reach the audit log" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#34d399;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="380" width="250" height="96" as="geometry" /></mxCell>
        <mxCell id="n13" value="Sentry avatar — 9 postures idle · listening · thinking · working speaking · waiting · success · alarm · dancing" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#8b5cf6;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="380" width="255" height="96" as="geometry" /></mxCell>
        <mxCell id="n14" value="Triage deliberately refuses to approve a tool call at all. That is the one decision the platform reserves for a named human." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#f43f5e;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1210" y="380" width="285" height="74" as="geometry" /></mxCell>
        <mxCell id="n15" value="Why the gate exists: this product's entire argument is that AI agents must be gated before they act. An assistant exempt from its own tool gateway would refute the thing it is embedded in." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#161620;strokeColor=#fbbf24;fontColor=#ededf5;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="1350" height="56" as="geometry" /></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" value="performance" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8b5cf6;dashed=1;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" value="no match" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=1;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" value="workflow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e22" value="gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#f43f5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e23" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#f43f5e;dashed=0;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a4a5e;dashed=1;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n6" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e25" value="records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34d399;dashed=1;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n6" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e26" value="drives" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8b5cf6;dashed=1;endArrow=block;endFill=1;fontColor=#9a9ab0;fontSize=10;labelBackgroundColor=#0b0b12;" edge="1" parent="1" source="n6" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell>
